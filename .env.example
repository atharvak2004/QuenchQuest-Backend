# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Website and admin panel origins (add both, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

ENGINE=django.db.backends.mysql
DB_NAME=quenchquest
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

EMAIL_HOST_USER=quenchquestsocialfoundation@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
ADMIN_NOTIFICATION_EMAIL=quenchquestsocialfoundation@gmail.com

JWT_ACCESS_HOURS=24
JWT_REFRESH_DAYS=30

# Optional: website cache refresh hook
WEBSITE_REVALIDATE_URL=
WEBSITE_REVALIDATE_SECRET=
